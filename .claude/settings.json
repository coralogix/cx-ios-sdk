        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.github/scripts/synced-readme.py\" hook"
          }
        ]
      }
    ]
  }
}
